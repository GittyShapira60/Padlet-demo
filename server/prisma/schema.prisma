// Prisma Schema
// Converted from DBML (padlet-like system)
// Migrated to MongoDB — see README for details

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum PadletBoardType {
  free_wall
  brainstorming
  grid
  timeline
}

enum PadletPermission {
  owner
  admin
  editor
  commenter
  viewer
}

enum PostAttachmentType {
  picture
  file
  link
}

enum PostContentKind {
  none
  attachment
  poll
}

enum NotificationType {
  reaction
  comment
  new_post
  padlet_share
}

// ─── Models ──────────────────────────────────────────────

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  username      String         @unique
  password_hash String

  padlets        Padlet[]
  posts          Post[]
  comments       Comment[]
  poll_votes     PollVote[]
  post_reactions PostReaction[]
  participants   Participant[]
  notifications  Notification[]
  padlet_visits  PadletVisit[]
}

model Padlet {
  padlet_id          String            @id @default(auto()) @map("_id") @db.ObjectId
  user_id            String            @db.ObjectId
  board_type         PadletBoardType
  default_permission PadletPermission?
  title              String
  description        String?
  background         String?
  created_at         DateTime
  updated_at         DateTime

  user         User          @relation(fields: [user_id], references: [id])
  posts        Post[]
  participants Participant[]
  visits       PadletVisit[]
}

model Post {
  post_id      String          @id @default(auto()) @map("_id") @db.ObjectId
  padlet_id    String          @db.ObjectId
  user_id      String          @db.ObjectId
  content_kind PostContentKind @default(none)
  post_type    String?
  title        String?
  subject      String?
  description  String?
  color        String?
  data_layout  Json?
  created_at   DateTime
  updated_at   DateTime

  padlet         Padlet          @relation(fields: [padlet_id], references: [padlet_id], onDelete: Cascade)
  user           User            @relation(fields: [user_id], references: [id])
  attachment     PostAttachment?
  poll           Poll?
  comments       Comment[]
  post_reactions PostReaction[]
}

model PostAttachment {
  post_id         String             @id @map("_id") @db.ObjectId
  attachment_type PostAttachmentType
  /// picture/file: base64 encoded; link: url+title; see SCHEMA.md
  attachment_data String

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
}

model Poll {
  poll_id  String @id @default(auto()) @map("_id") @db.ObjectId
  post_id  String @unique @db.ObjectId
  question String

  post         Post         @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  poll_options PollOption[]
  poll_votes   PollVote[]
}

model PollOption {
  option_id  String @id @default(auto()) @map("_id") @db.ObjectId
  poll_id    String @db.ObjectId
  label      String
  sort_order Int

  poll       Poll       @relation(fields: [poll_id], references: [poll_id], onDelete: Cascade)
  poll_votes PollVote[]

  @@unique([poll_id, sort_order])
}

model PollVote {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  poll_id   String @db.ObjectId
  user_id   String @db.ObjectId
  option_id String @db.ObjectId

  poll   Poll       @relation(fields: [poll_id], references: [poll_id], onDelete: Cascade)
  user   User       @relation(fields: [user_id], references: [id])
  option PollOption @relation(fields: [option_id], references: [option_id], onDelete: Cascade)

  @@unique([poll_id, user_id])
}

model Participant {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  padlet_id  String           @db.ObjectId
  user_id    String           @db.ObjectId
  permission PadletPermission

  padlet Padlet @relation(fields: [padlet_id], references: [padlet_id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  @@unique([padlet_id, user_id])
}

model Comment {
  comment_id String    @id @default(auto()) @map("_id") @db.ObjectId
  post_id    String    @db.ObjectId
  user_id    String    @db.ObjectId
  body       String
  created_at DateTime
  updated_at DateTime?

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id])
}

model PostReaction {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  post_id       String @db.ObjectId
  user_id       String @db.ObjectId
  reaction_code String

  post Post @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id, reaction_code])
}

model Notification {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  user_id        String           @db.ObjectId
  type           NotificationType
  actor_username String
  padlet_id      String?          @db.ObjectId
  post_id        String?          @db.ObjectId
  is_read        Boolean          @default(false)
  created_at     DateTime

  user User @relation(fields: [user_id], references: [id])
}

model PadletVisit {
  visit_id     String   @id @default(auto()) @map("_id") @db.ObjectId
  padlet_id    String   @db.ObjectId
  user_id      String?  @db.ObjectId
  visited_at   DateTime
  duration_sec Int?

  padlet Padlet @relation(fields: [padlet_id], references: [padlet_id], onDelete: Cascade)
  user   User?  @relation(fields: [user_id], references: [id])

  @@index([padlet_id, visited_at])
}
