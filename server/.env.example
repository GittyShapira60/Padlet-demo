# Copy to .env: cp .env.example .env

NODE_ENV=development
PORT=3000

DATABASE_URL=mongodb://localhost:27018/padlet_db?replicaSet=rs0

CORS_ORIGIN=http://localhost:5173
API_PREFIX=api
SWAGGER_ENABLED=true

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=padlet_minio
S3_SECRET_KEY=padlet_minio_secret
S3_BUCKET=padlet-images
S3_REGION=us-east-1
