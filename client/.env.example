# Copy to .env: copy .env.example .env

# --- Local: server + client with npm (recommended — uses Vite proxy, no CORS issues) ---
VITE_API_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:3000

# --- Local: server in Docker (port 3001), client with npm ---
# VITE_API_URL=http://localhost:3001/api

# --- Full Docker (docker compose sets VITE_API_URL for the client container) ---
